{
  "name": "mooduck-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build && cp -f public/404.html out/404.html",
    "preview": "npx -y serve out -l 3002",
    "lint": "next lint --max-warnings=0",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "screenshot": "playwright test readme-screenshot --project=chromium",
    "typecheck": "tsc --noEmit",
    "codecheck": "pnpm run typecheck && pnpm run lint"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@mooduck/core": "workspace:*",
    "clsx": "^2.1.1",
    "next": "^15.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
