# `map` is only valid in the `http` context (not inside `server`), and
# `sites-enabled/*` / `conf.d/*` are included there — so it goes at the top of
# this file, above the `server` block. It picks a locale from Accept-Language so
# a bare "/" can redirect to /en or /ru.
map $http_accept_language $mooduck_locale {
  default  /en;
  "~*^ru"  /ru;
}

server {
  # Write your landing domain. For example, mooduck.shrek-labs.dev
  server_name your-landing-hostname.com;

  listen [::]:443 ssl;
  listen 443 ssl;

  # Place your certificates config in `/etc/nginx/conf.d/ssl.conf`.
  # Remove, if you don't need HTTPS on the nginx level.
  include conf.d/ssl.conf;

  access_log /var/log/nginx/mooduck-landing.access.log;
  error_log /var/log/nginx/mooduck-landing.error.log;

  # `mooduck-landing` is a Next.js static export (output: "export").
  # `pnpm build` writes the site here — nothing needs to run; nginx serves files.
  root /var/www/mooduck/apps/landing/out;

  index index.html;
  charset utf-8;

  # The landing lives at /en and /ru; "/" picks one and gets out of the way.
  # Exact match, so /en, /ru, /app and everything else are untouched.
  location = / {
    return 302 $mooduck_locale;
  }

  # The web app: a Vite SPA built to apps/web/dist, served at /app.
  location /app {
    alias /var/www/mooduck/apps/web/dist;
    try_files $uri $uri/ /app/index.html;

    # The Node app sets contentSecurityPolicy:false, so the CSP for the app
    # document lives here. It must allow Telegram's widget script and auth
    # iframe, t.me avatar images, and the Google Fonts stylesheet/files.
    #
    # 'unsafe-eval' is required and not negotiable: telegram-widget.js reads its
    # `data-onauth` attribute by wrapping it in a function string and calling
    # eval. The eval-free alternative, `data-auth-url`, silently fails for anyone
    # already signed in to Telegram, so this is the cost of a login button that
    # works. Nothing in the app itself evals; scripts are still restricted to
    # this origin and telegram.org.
    # `img-src` needs no Telegram hosts: avatars are fetched by the server and
    # served back from /api/auth/avatar, so every image here is same-origin.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' https://telegram.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src https://oauth.telegram.org https://telegram.org; connect-src 'self'; base-uri 'self'; form-action 'self'" always;
  }

  # Hashed, immutable SPA assets.
  location /app/assets/ {
    alias /var/www/mooduck/apps/web/dist/assets/;
    access_log off;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # The web API, proxied to the Node process on the same host (same-origin ⇒ the
  # session cookie's SameSite=Strict works and there is no CORS).
  location /api/ {
    proxy_pass http://localhost:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Hashed, immutable Next.js build assets.
  location /_next/static/ {
    access_log off;
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Static pages: serve the file, its `.html` variant, or fall back to 404.
  # "/en" → out/en.html, "/ru" → out/ru.html (no extra rule needed).
  location / {
    try_files $uri $uri.html $uri/index.html =404;
  }

  error_page 404 /404.html;

  client_max_body_size 10M;
}
