server {
  # Write your landing domain. For example, mooduck.shrek-labs.dev
  server_name your-landing-hostname.com;

  listen [::]:443 ssl;
  listen 443 ssl;

  # Place your certificates config in `/etc/nginx/conf.d/ssl.conf`.
  # Remove, if you don't need HTTPS on the nginx level.
  include conf.d/ssl.conf;

  access_log /var/log/nginx/mooduck-landing.access.log;
  error_log /var/log/nginx/mooduck-landing.error.log;

  # `mooduck-landing` is a Next.js static export (output: "export").
  # `pnpm build` writes the site here — nothing needs to run; nginx serves files.
  root /var/www/mooduck/apps/landing/out;

  index index.html;
  charset utf-8;

  # Hashed, immutable build assets.
  location /_next/static/ {
    access_log off;
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Static pages: serve the file, its `.html` variant, or fall back to 404.
  location / {
    try_files $uri $uri.html $uri/index.html =404;
  }

  error_page 404 /404.html;

  client_max_body_size 10M;
}
