server {
  # Write your domain. For example, mooduck.shrek-labs.dev
  server_name your-hostname.com;

  listen [::]:443 ssl;
  listen 443 ssl;

  # Place your certificates config in `/etc/nginx/conf.d/ssl.conf`.
  # Remove, if don't need HTTPs on the nginx level
  include conf.d/ssl.conf;

  access_log /var/log/nginx/mooduck.access.log;
  error_log /var/log/nginx/mooduck.error.log;

  # Place the repo at `/var/www/mooduck`
  root /var/www/mooduck/apps/web/dist;

  # Basic settings
  index index.html;
  charset utf-8;

  # Handle /assets/*
  location ~ ^/assets/ {
    # Disable access logging for static assets
    access_log off;
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Single location for all proxied paths
  location ~ ^/(telegram/webhook/SECRET_PATH_GENERATED_SOMEHOW|health|api/) {
    proxy_pass http://localhost:3001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_cache_bypass $http_upgrade;

    # Timeouts
    client_max_body_size 100M;
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
  }

  # All other paths - SPA routing
  location / {
    try_files $uri $uri/ /index.html;
    # SPA cache headers
    expires -1;
    add_header Cache-Control "no-store, no-cache, must-revalidate";
  }

  # Error pages
  error_page 404 /index.html;

  client_max_body_size 100M;
}
