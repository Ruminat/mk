server {
  # Write your domain. For example, mooduck.shrek-labs.dev
  server_name your-hostname.com;

  listen [::]:443 ssl;
  listen 443 ssl;

  # Place your certificates config in `/etc/nginx/conf.d/ssl.conf`.
  # Remove, if don't need HTTPs on the nginx level
  include conf.d/ssl.conf;

  access_log /var/log/nginx/mooduck.access.log;
  error_log /var/log/nginx/mooduck.error.log;

  charset utf-8;

  # Nothing static is served from this host: MooDuck is a Telegram bot, so this is
  # a plain reverse proxy to the Node process. (A React SPA used to live at
  # `apps/web/dist`; it was removed and will be rewritten later.)

  # The only two things the server answers.
  location ~ ^/(telegram/webhook/SECRET_PATH_GENERATED_SOMEHOW|health)$ {
    proxy_pass http://localhost:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Timeouts
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
  }

  # Telegram updates are small and nothing here accepts uploads.
  client_max_body_size 1M;

  # Anything else has no business being here.
  location / {
    return 404;
  }
}
